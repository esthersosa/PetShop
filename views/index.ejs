<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PetShop - Painel de Controle</title>
    <style>
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            margin: 0; 
            padding: 40px; 
            background-color: #e3f2fd; 
            color: #4A1525;
            position: relative;
        }
        .container { 
            max-width: 1000px; 
            margin: 0 auto; 
            position: relative;
        }
        
        /* Bichinhos e Decorações Laterais Flutuantes da Imagem */
        .decoracao-bunny-top { position: absolute; top: -10px; right: -40px; font-size: 65px; z-index: 10; }
        .decoracao-bunny-mid { position: absolute; top: 310px; left: 240px; font-size: 55px; z-index: 10; }
        .decoracao-dog-bottom { position: absolute; bottom: -10px; left: -50px; font-size: 75px; z-index: 10; }
        .decoracao-cloud-left { position: absolute; top: 80px; left: -60px; font-size: 45px; }
        .decoracao-cloud-right { position: absolute; bottom: 80px; right: -60px; font-size: 45px; }

        h2 { color: #4A1525; margin-top: 35px; font-size: 26px; display: flex; align-items: center; gap: 8px; font-weight: bold; }
        
        .grid-formularios { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin-bottom: 40px; }
        .card { background: white; padding: 20px; border-radius: 20px; box-shadow: 0 8px 16px rgba(0,0,0,0.04); border: 3px solid #bde0fe; }
        .card h3 { color: #4A1525; margin-top: 0; margin-bottom: 15px; font-size: 18px; }
        
        .form-group { margin-bottom: 12px; }
        .form-group label { display: block; margin-bottom: 5px; font-weight: bold; color: #4A1525; font-size: 13px; }
        .form-group input { width: 100%; padding: 10px; border: 2px solid #bde0fe; border-radius: 12px; box-sizing: border-box; font-size: 13px; background-color: #fff; }
        .form-group input:focus { border-color: #ffafcc; outline: none; }
        
        button { color: white; border: none; padding: 10px 15px; border-radius: 12px; cursor: pointer; font-size: 14px; font-weight: bold; width: 100%; transition: transform 0.2s; }
        button:hover { transform: scale(1.02); }
        
        /* Estilização das Tabelas Arredondadas do seu Print */
        table { width: 100%; border-collapse: separate; border-spacing: 0 8px; margin-top: 5px; margin-bottom: 25px; }
        th, td { padding: 12px 18px; text-align: left; font-size: 15px; }
        th { background-color: #bde0fe; color: #4A1525; font-weight: bold; border: none; }
        th:first-child { border-top-left-radius: 15px; border-bottom-left-radius: 15px; }
        th:last-child { border-top-right-radius: 15px; border-bottom-right-radius: 15px; }
        
        td { border: none; color: #333; font-weight: 500; }
        tr td:first-child { border-top-left-radius: 15px; border-bottom-left-radius: 15px; }
        tr td:last-child { border-top-right-radius: 15px; border-bottom-right-radius: 15px; }
        
        .coracao { color: #ffafcc; font-size: 22px; margin-left: 5px; }
        .icone-titulo { font-size: 28px; margin-right: 8px; }
    </style>
</head>
<body>
    <div class="decoracao-bunny-top">🐰</div>
    <div class="decoracao-bunny-mid">🐰</div>
    <div class="decoracao-dog-bottom">🐶</div>
    <div class="decoracao-cloud-left">☁️🤍</div>
    <div class="decoracao-cloud-right">☁️🤍</div>

    <div class="container">
        <div class="grid-formularios">
            <!-- Formulário Tutor -->
            <div class="card" style="border-color: #bde0fe;">
                <h3>➕ Novo Tutor</h3>
                <form action="/web/tutores" method="POST">
                    <div class="form-group"><label>Nome Completo</label><input type="text" name="nome" placeholder="Ex: João da Silva" required></div>
                    <div class="form-group"><label>E-mail</label><input type="email" name="email" placeholder="Ex: joao@email.com" required></div>
                    <div class="form-group"><label>Telefone</label><input type="text" name="telefone" placeholder="Ex: 43999999999" required></div>
                    <button type="submit" style="background-color: #a2d2ff; color: #4A1525;">Salvar Tutor</button>
                </form>
            </div>

            <!-- Formulário Pet -->
            <div class="card" style="border-color: #ffafcc;">
                <h3>🐇 Novo Pet</h3>
                <form action="/web/pets" method="POST">
                    <div class="form-group"><label>Nome do Pet</label><input type="text" name="nome" placeholder="Ex: Floquinho" required></div>
                    <div class="form-group"><label>Espécie</label><input type="text" name="especie" placeholder="Ex: Coelho" required></div>
                    <div class="form-group"><label>Raça</label><input type="text" name="raca" placeholder="Ex: Mini Loop" required></div>
                    <div class="form-group"><label>ID do Tutor Dono</label><input type="number" name="tutorId" placeholder="Ex: 1" required></div>
                    <button type="submit" style="background-color: #ffafcc; color: #4A1525;">Salvar Pet</button>
                </form>
            </div>

            <!-- Formulário Agendamento -->
            <div class="card" style="border-color: #ffc8dd;">
                <h3>📅 Novo Agendamento</h3>
                <form action="/web/agendamentos" method="POST">
                    <div class="form-group"><label>Data e Horário</label><input type="datetime-local" name="dataHora" required></div>
                    <div class="form-group"><label>Serviço</label><input type="text" name="servico" placeholder="Ex: Banho e Tosa" required></div>
                    <div class="form-group"><label>ID do Pet</label><input type="number" name="petId" placeholder="Ex: 1" required></div>
                    <button type="submit" style="background-color: #ffc8dd; color: #4A1525;">Agendar Horário</button>
                </form>
            </div>
        </div>

        <!-- Tabelas Fofas Corrigidas -->
        <h2><span class="icone-titulo">🐰</span> Tutores Cadastrados <span class="coracao">💖</span></h2>
        <table>
            <thead>
                <tr>
                    <th style="width: 10%;">ID</th>
                    <th style="width: 30%;">Nome</th>
                    <th style="width: 35%;">E-mail</th>
                    <th style="width: 25%;">Telefone</th>
                </tr>
            </thead>
            <tbody>
                <% if (tutores.length === 0) { %>
                    <tr style="background-color: white;"><td colspan="4" style="text-align:center;">Nenhum tutor cadastrado.</td></tr>
                <% } else { %>
                    <% 
                    const cores = ['#cff4fc', '#f8d7da', '#d1e7dd', '#fff3cd'];
                    tutores.forEach((tutor, index) => { 
                        const corFundo = cores[index % cores.length];
                    %>
                        <tr style="background-color: <%= corFundo %>;">
                            <td><strong><%= tutor.id %></strong></td>
                            <td><%= tutor.nome %></td>
                            <td><%= tutor.email %></td>
                            <td><%= tutor.telefone %></td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>

        <h2><span class="icone-titulo">🐰</span> Pets Cadastrados</h2>
        <table>
            <thead>
                <tr>
                    <th style="width: 10%;">ID</th>
                    <th style="width: 30%;">Nome</th>
                    <th style="width: 35%;">Espécie/Raça</th>
                    <th style="width: 25%;">Dono (Tutor)</th>
                </tr>
            </thead>
            <tbody>
                <% if (pets.length === 0) { %>
                    <tr style="background-color: white;"><td colspan="4" style="text-align:center;">Nenhum pet cadastrado.</td></tr>
                <% } else { %>
                    <% pets.forEach(pet => { %>
                        <tr style="background-color: #fff3cd;">
                            <td><strong><%= pet.id %></strong></td>
                            <td><%= pet.nome %> 🐾</td>
                            <td><%= pet.especie %> (${pet.raca})</td>
                            <td><%= pet.tutor?.nome || 'Não informado' %> (ID: <%= pet.tutorId %>)</td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>

        <h2><span class="icone-titulo">🗓️</span> Compromissos Agendados <span class="coracao">🤍</span></h2>
        <table>
            <thead>
                <tr>
                    <th style="width: 10%;">ID</th>
                    <th style="width: 25%;">Data/Hora</th>
                    <th style="width: 30%;">Serviço</th>
                    <th style="width: 15%;">Status</th>
                    <th style="width: 20%;">Pet</th>
                </tr>
            </thead>
            <tbody>
                <% if (agendamentos.length === 0) { %>
                    <tr style="background-color: white;"><td colspan="5" style="text-align:center;">Nenhum agendamento pendente.</td></tr>
                <% } else { %>
                    <% agendamentos.forEach(ag => { %>
                        <tr style="background-color: #fff3cd;">
                            <td><strong><%= ag.id %></strong></td>
                            <td><%= new Date(ag.dataHora).toLocaleString('pt-BR').substring(0, 16) %></td>
                            <td><%= ag.servico %></td>
                            <td><span style="background-color: #d1e7dd; color: #0f5132; padding: 4px 12px; border-radius: 20px; font-weight: bold; font-size: 13px;"><%= ag.status %></span></td>
